# DevAnnounce environment configuration
# ./run.sh copies this to .env on first run and generates fresh secrets.

# Public port the app is served on (Nginx)
APP_PORT=8080

# PostgreSQL
POSTGRES_USER=devannounce
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devannounce

# Auth
JWT_SECRET=change-me

# MinIO object storage
MINIO_ROOT_USER=devannounce
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=devannounce

# production | development
ENVIRONMENT=production

# Seed demo users/posts/news on first start (admin account is always created)
SEED_DEMO_DATA=true
